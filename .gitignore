# build output
dist/

# generated types
.astro/
.wrangler/

# test artifacts
test-results/
playwright-report/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.build-metrics.json

# environment variables
.env*
!.env.example

# OS and IDE files
.DS_Store
.idea/

# agent task checkpoint
/TASK_MEMORY.md
/.task-memory/

# media binaries: published to Cloudflare R2 by scripts/publish-media.mjs.
# Only the versioned catalog travels in Git.
/src/content/**/midia/*
!/src/content/**/midia/catalogo.json
# The fictional example contest keeps its tiny fixture media in Git, so the
# end-to-end suite can exercise the player without depending on the cloud.
!/src/content/assuntos/concurso-exemplo/**/midia/*

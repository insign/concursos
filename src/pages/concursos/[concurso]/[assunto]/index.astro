---
import { render } from 'astro:content';
import AbbreviationRuntime from '../../../../components/AbbreviationRuntime.astro';
import DocumentReferences from '../../../../components/DocumentReferences.astro';
import MermaidRuntime from '../../../../components/MermaidRuntime.astro';
import StudyLayout from '../../../../layouts/StudyLayout.astro';
import { getSubjectStaticPaths, type CatalogContest, type CatalogSubject } from '../../../../lib/catalog';
import { hasMermaidCodeFence } from '../../../../lib/resolution-markdown';

interface Props {
  contest: CatalogContest;
  subject: CatalogSubject;
}

export const getStaticPaths = getSubjectStaticPaths;

const { contest, subject } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(subject.contentEntry);
const body = subject.contentEntry.body ?? '';
const hasContentAbbreviation = remarkPluginFrontmatter.hasTitledAbbreviation === true;
const contentHasH1 = /^\s*#\s/.test(body);

const referencesEntry = subject.referencesEntry;
const referencesRendered = referencesEntry ? await render(referencesEntry) : null;
const ReferencesContent = referencesRendered?.Content ?? null;
const referencesBody = referencesEntry?.body ?? '';
const hasAbbreviation =
  hasContentAbbreviation || referencesRendered?.remarkPluginFrontmatter.hasTitledAbbreviation === true;
const hasMermaid = hasMermaidCodeFence(body) || hasMermaidCodeFence(referencesBody);
---

<StudyLayout contest={contest} subject={subject} active="content">
  <div class="reading-entry print-hidden">
    <a class="reading-entry-link" href="#focus" data-reading-focus-open>
      Ler sem distrações
    </a>
  </div>
  <article>
    {!contentHasH1 && <h1 class="reading-title">{subject.title}</h1>}
    <Content />
    {referencesRendered && ReferencesContent && (
      <DocumentReferences>
        <ReferencesContent />
      </DocumentReferences>
    )}
  </article>
  {hasAbbreviation && <AbbreviationRuntime />}
  {hasMermaid && <MermaidRuntime />}
</StudyLayout>

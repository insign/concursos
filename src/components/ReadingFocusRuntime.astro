<script>
  const root = document.querySelector<HTMLElement>('[data-reading-focus]');
  const openers = root
    ? Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-reading-focus-open]'))
    : [];
  const defaultOpener = openers[0] ?? null;
  const close = root?.querySelector<HTMLAnchorElement>('[data-reading-focus-close]') ?? null;
  const progressIndicator = root?.querySelector<HTMLOutputElement>('[data-reading-progress]') ?? null;
  const readingArticle = root?.querySelector<HTMLElement>('.reading-surface > article') ?? null;

  if (root && defaultOpener && close) {
    const HISTORY_KEY = 'concursosReadingFocus';
    const FOCUSABLE = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([tabindex="-1"])',
    ].join(',');

    interface ExternalState {
      element: HTMLElement;
      inert: boolean;
      ariaHidden: string | null;
    }

    interface LayoutState {
      anchor: HTMLElement;
      anchorTop: number;
    }

    interface PendingTraversal {
      layout: LayoutState;
    }

    let active: boolean | null = null;
    let opener: HTMLElement | null = null;
    let externalStates: ExternalState[] = [];
    let pendingTraversal: PendingTraversal | null = null;
    let previousScrollRestoration: ScrollRestoration | null = null;
    let fullscreenDesired = false;
    let fullscreenRequest: Promise<void> | null = null;
    let fullscreenRequestToken: symbol | null = null;
    let fullscreenExit: Promise<void> | null = null;
    let progressFrame = 0;

    const fullscreenTarget = document.documentElement;
    const layoutAnchor = root.querySelector<HTMLElement>('.reading-surface > article') ?? root;
    const CONTENT_ANCHORS = 'h1, h2, h3, h4, h5, h6, p, li, blockquote, pre, table, figure';

    const isFocusHash = () => location.hash === '#focus';
    const hasFocusHistoryState = () =>
      typeof history.state === 'object' && history.state !== null && history.state[HISTORY_KEY] === true;

    function leaveReadingFullscreen(): Promise<void> {
      fullscreenDesired = false;
      if (fullscreenExit) return fullscreenExit;
      const pendingRequest = fullscreenRequest;
      const operation = (async () => {
        if (pendingRequest) await pendingRequest;
        if (
          fullscreenDesired ||
          document.fullscreenElement !== fullscreenTarget ||
          typeof document.exitFullscreen !== 'function'
        ) return;
        try {
          await document.exitFullscreen();
        } catch {
          // Fullscreen is optional; focus mode must still close normally.
        }
      })();
      fullscreenExit = operation;
      void operation.finally(() => {
        if (fullscreenExit === operation) fullscreenExit = null;
      });
      return operation;
    }

    const requestReadingFullscreen = () => {
      if (
        document.fullscreenEnabled === false ||
        typeof fullscreenTarget.requestFullscreen !== 'function'
      ) return;
      fullscreenDesired = true;
      if (document.fullscreenElement === fullscreenTarget || fullscreenRequest) return;

      const token = Symbol('reading-fullscreen-request');
      fullscreenRequestToken = token;
      let request: Promise<void>;
      try {
        request = Promise.resolve(fullscreenTarget.requestFullscreen());
      } catch {
        fullscreenDesired = false;
        fullscreenRequestToken = null;
        return;
      }
      fullscreenRequest = request
        .catch(() => {
          if (fullscreenRequestToken === token) fullscreenDesired = false;
        })
        .finally(() => {
          if (fullscreenRequestToken === token) {
            fullscreenRequest = null;
            fullscreenRequestToken = null;
          }
          if (!fullscreenDesired) void leaveReadingFullscreen();
        });
    };

    const visibleLayoutAnchor = (): HTMLElement => {
      const anchorLine = window.innerHeight / 2;
      const hit = document.elementFromPoint(window.innerWidth / 2, anchorLine);
      const hitAnchor = hit instanceof Element ? hit.closest<HTMLElement>(CONTENT_ANCHORS) : null;
      if (hitAnchor && layoutAnchor.contains(hitAnchor)) return hitAnchor;

      const candidates = Array.from(layoutAnchor.querySelectorAll<HTMLElement>(CONTENT_ANCHORS));
      const first = candidates.shift();
      if (!first) return layoutAnchor;
      const distance = (element: HTMLElement) => {
        const rect = element.getBoundingClientRect();
        if (rect.top <= anchorLine && rect.bottom >= anchorLine) return 0;
        return Math.min(Math.abs(rect.top - anchorLine), Math.abs(rect.bottom - anchorLine));
      };
      return candidates.reduce((closest, candidate) => {
        return distance(candidate) < distance(closest) ? candidate : closest;
      }, first);
    };

    const captureLayout = (): LayoutState => {
      const anchor = visibleLayoutAnchor();
      return {
        anchor,
        anchorTop: anchor.getBoundingClientRect().top,
      };
    };

    const preserveLayout = (previous?: LayoutState) => {
      if (!previous) return;
      const anchor = previous.anchor.isConnected ? previous.anchor : layoutAnchor;
      const delta = anchor.getBoundingClientRect().top - previous.anchorTop;
      if (delta !== 0) window.scrollTo({ top: window.scrollY + delta });
    };

    const outsideElements = (): HTMLElement[] => {
      const main = root.parentElement;
      if (!main) return [];
      const bodySiblings = Array.from(document.body.children).filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== main && element.tagName !== 'SCRIPT',
      );
      const mainSiblings = Array.from(main.children).filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== root && element.tagName !== 'SCRIPT',
      );
      return [...bodySiblings, ...mainSiblings];
    };

    const hideOutside = () => {
      externalStates = outsideElements().map((element) => ({
        element,
        inert: element.hasAttribute('inert'),
        ariaHidden: element.getAttribute('aria-hidden'),
      }));
      externalStates.forEach(({ element }) => {
        element.inert = true;
        element.setAttribute('aria-hidden', 'true');
      });
    };

    const restoreOutside = () => {
      externalStates.forEach(({ element, inert, ariaHidden }) => {
        element.toggleAttribute('inert', inert);
        if (ariaHidden === null) element.removeAttribute('aria-hidden');
        else element.setAttribute('aria-hidden', ariaHidden);
      });
      externalStates = [];
    };

    const focusableElements = () =>
      Array.from(root.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (element) => !element.hidden && element.getClientRects().length > 0,
      );

    const setActive = (next: boolean, layout?: LayoutState): boolean => {
      if (active === next) return false;
      active = next;
      root.toggleAttribute('data-reading-focus-active', next);
      document.body.classList.toggle('reading-focus-active', next);

      if (next) {
        if (previousScrollRestoration === null) {
          previousScrollRestoration = history.scrollRestoration;
          history.scrollRestoration = 'manual';
        }
        root.setAttribute('role', 'dialog');
        root.setAttribute('aria-modal', 'true');
        hideOutside();
      } else {
        void leaveReadingFullscreen();
        root.removeAttribute('role');
        root.removeAttribute('aria-modal');
        restoreOutside();
      }

      preserveLayout(layout);
      window.dispatchEvent(new CustomEvent('concursos:reading-focus-change', { detail: { active: next } }));

      requestAnimationFrame(() => {
        if (next) root.focus({ preventScroll: true });
        else (opener?.isConnected ? opener : defaultOpener).focus({ preventScroll: true });
      });
      if (!next && previousScrollRestoration !== null) {
        const restoration = previousScrollRestoration;
        requestAnimationFrame(() => {
          if (active || previousScrollRestoration !== restoration) return;
          history.scrollRestoration = restoration;
          previousScrollRestoration = null;
        });
      }
      return true;
    };

    const syncFromLocation = () => {
      const pending = pendingTraversal;
      pendingTraversal = null;
      const layout = pending?.layout ?? captureLayout();
      const changed = setActive(isFocusHash(), layout);
      // A restauração nativa de histórico pode acontecer depois de popstate; reaplica
      // a âncora no próximo frame para preservar o mesmo ponto visual de leitura.
      if (changed) requestAnimationFrame(() => preserveLayout(layout));
    };

    const closeFocus = () => {
      if (!isFocusHash()) return;
      void leaveReadingFullscreen();
      if (hasFocusHistoryState()) {
        if (pendingTraversal) return;
        pendingTraversal = {
          layout: captureLayout(),
        };
        history.back();
        return;
      }

      const layout = captureLayout();
      const url = new URL(location.href);
      url.hash = '';
      history.replaceState(history.state, '', `${url.pathname}${url.search}`);
      setActive(false, layout);
    };

    const renderReadingProgress = () => {
      progressFrame = 0;
      if (!progressIndicator || !readingArticle) return;
      const article = readingArticle.getBoundingClientRect();
      const start = window.scrollY + article.top;
      const scrollable = Math.max(0, article.height - window.innerHeight);
      const progress = scrollable === 0
        ? 1
        : Math.min(1, Math.max(0, (window.scrollY - start) / scrollable));
      const label = `${Math.round(progress * 100)}%`;
      if (progressIndicator.textContent === label) return;
      progressIndicator.textContent = label;
      progressIndicator.setAttribute('aria-label', `Progresso da leitura: ${label}`);
    };

    const scheduleReadingProgress = () => {
      if (!progressFrame) progressFrame = requestAnimationFrame(renderReadingProgress);
    };
    const articleForObserver = readingArticle;
    const progressResizeObserver =
      articleForObserver && typeof ResizeObserver === 'function'
        ? new ResizeObserver(scheduleReadingProgress)
        : null;
    if (progressResizeObserver && articleForObserver) progressResizeObserver.observe(articleForObserver);

    for (const open of openers) {
      open.addEventListener('click', (event) => {
        if (isFocusHash()) return;
        event.preventDefault();
        if (fullscreenExit) return;
        opener = open;
        const layout = captureLayout();
        const state =
          typeof history.state === 'object' && history.state !== null ? { ...history.state } : {};
        state[HISTORY_KEY] = true;
        const url = new URL(location.href);
        url.hash = 'focus';
        history.pushState(state, '', `${url.pathname}${url.search}${url.hash}`);
        setActive(true, layout);
        requestReadingFullscreen();
      });
    }

    close.addEventListener('click', (event) => {
      event.preventDefault();
      closeFocus();
    });

    document.addEventListener('keydown', (event) => {
      if (!active) return;
      if (event.key === 'Escape') {
        if (event.defaultPrevented || root.querySelector('.reading-customizer-panel:not([hidden])')) return;
        event.preventDefault();
        closeFocus();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = focusableElements();
      if (focusable.length === 0) {
        event.preventDefault();
        root.focus({ preventScroll: true });
        return;
      }

      const first = focusable[0];
      const last = focusable.at(-1) ?? first;
      if (
        event.shiftKey &&
        (document.activeElement === root ||
          document.activeElement === first ||
          !root.contains(document.activeElement))
      ) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('popstate', syncFromLocation);
    window.addEventListener('hashchange', syncFromLocation);
    window.addEventListener('scroll', scheduleReadingProgress, { passive: true });
    window.addEventListener('resize', scheduleReadingProgress, { passive: true });
    window.addEventListener('concursos:reading-focus-change', scheduleReadingProgress);
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement !== fullscreenTarget && !fullscreenRequest) {
        fullscreenDesired = false;
      }
    });
    window.addEventListener('concursos:subject-unread', () => {
      void leaveReadingFullscreen();
    });

    setActive(isFocusHash());
    root.setAttribute('data-reading-focus-ready', '');
    scheduleReadingProgress();
  }
</script>

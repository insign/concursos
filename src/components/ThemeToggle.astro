---
---

<button
  class="header-icon-control theme-control"
  type="button"
  aria-label="Tema automático. Próxima opção: tema claro"
  data-theme-toggle
  data-theme-preference="auto"
  data-tooltip="Tema automático"
>
  <svg data-theme-icon="auto" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="7.5"></circle>
    <path class="theme-auto-fill" d="M12 4.5a7.5 7.5 0 0 1 0 15Z"></path>
  </svg>
  <svg data-theme-icon="light" class="control-icon-hidden" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg data-theme-icon="dark" class="control-icon-hidden" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M19.5 15.2A8.2 8.2 0 0 1 8.8 4.5 8.2 8.2 0 1 0 19.5 15.2Z"></path>
  </svg>
</button>

<script>
  import {
    THEME_STORAGE_KEY,
    THEME_COLORS,
    nextThemePreference,
    readThemePreference,
    resolveTheme,
    type ThemePreference,
  } from '../lib/theme';

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const labels: Record<ThemePreference, string> = {
    auto: 'automático',
    light: 'claro',
    dark: 'escuro',
  };

  const currentPreference = (): ThemePreference => {
    try {
      return readThemePreference(localStorage.getItem(THEME_STORAGE_KEY));
    } catch {
      return readThemePreference(null);
    }
  };

  const applyPreference = (preference: ThemePreference) => {
    const resolved = resolveTheme(preference, media.matches);
    document.documentElement.dataset.theme = resolved;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', THEME_COLORS[resolved]);
  };

  if (button) {
    let preference = currentPreference();

    const renderControl = () => {
      const next = nextThemePreference(preference);
      button.dataset.themePreference = preference;
      button.dataset.tooltip = `Tema ${labels[preference]}`;
      button.setAttribute(
        'aria-label',
        `Tema ${labels[preference]}. Próxima opção: tema ${labels[next]}`,
      );
      for (const icon of button.querySelectorAll<SVGElement>('[data-theme-icon]')) {
        icon.classList.toggle('control-icon-hidden', icon.dataset.themeIcon !== preference);
      }
    };

    // Reafirma o tema (o script inline já aplicou data-theme) e ajusta o theme-color.
    applyPreference(preference);
    renderControl();

    button.addEventListener('click', () => {
      preference = nextThemePreference(preference);
      try {
        localStorage.setItem(THEME_STORAGE_KEY, preference);
      } catch {
        // Sem localStorage gravável: aplica na sessão atual sem persistir.
      }
      applyPreference(preference);
      renderControl();
    });

    // No modo automático, acompanha a mudança da preferência do sistema em tempo real.
    media.addEventListener('change', () => {
      if (preference === 'auto') applyPreference('auto');
    });
  }
</script>

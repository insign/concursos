---
import ProgressSummary from './ProgressSummary.astro';
import SubjectStudiedIndicator from './SubjectStudiedIndicator.astro';
import type { CatalogContest, CatalogTreeNode } from '../lib/catalog';
import { megaReviewRoute } from '../lib/mega-review-routes';

interface Props {
  contest: CatalogContest;
  nodes: CatalogTreeNode[];
  depth?: number;
}

const { contest, nodes, depth = 0 } = Astro.props;
const Heading = `h${Math.min(depth + 2, 6)}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const rootTreeId = depth === 0 ? `subject-tree-${contest.storageId}` : undefined;
---

{
  depth === 0 && (
    <div class="subject-tree-controls print-hidden" data-subject-tree-controls hidden>
      <button
        class="button button-secondary"
        type="button"
        data-subject-tree-toggle
        aria-controls={rootTreeId}
      >
        Expandir tudo
      </button>
    </div>
  )
}

<ol class="subject-tree" data-depth={depth} id={rootTreeId}>
  {
    nodes.map((node) =>
      node.kind === 'subject' ? (
        <li class="subject-item">
          <article class="subject-card">
            <a class="subject-card-title" href={`/concursos/${contest.slug}/${node.slug}/`}>{node.title}</a>
            <div class="subject-card-meta">
              <SubjectStudiedIndicator
                contestStorageId={contest.storageId}
                subjectStorageId={node.storageId}
              />
              <a
                class="subject-reading-link"
                href={`/concursos/${contest.slug}/${node.slug}/#focus`}
                aria-label={`Ler ${node.title} sem distrações`}
              >
                <svg
                  class="subject-reading-icon"
                  viewBox="0 0 24 24"
                  width="1em"
                  height="1em"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <path d="M8 8h8M8 12h8M8 16h5" />
                </svg>
              </a>
              <ProgressSummary
                contestStorageId={contest.storageId}
                subjectStorageId={node.storageId}
                questionSetRevision={node.questionSetEntry.data.questionSetRevision}
              />
            </div>
          </article>
        </li>
      ) : (
        <li class="subject-group">
          <details class="subject-group-section" open data-group-id={node.id}>
            <summary class="subject-group-summary">
              <Heading class="subject-group-title">{node.title}</Heading>
            </summary>
            {node.description && <p class="subject-group-description">{node.description}</p>}
            {node.megaReview && (
              <p class="group-mega-review-entry" data-group-mega-review>
                <a
                  class="group-mega-review-link"
                  href={megaReviewRoute(contest.slug, node.megaReview.slug)}
                >
                  <span class="group-mega-review-label">Mega revisão</span>
                  <span>{node.megaReview.title}</span>
                </a>
              </p>
            )}
            <Astro.self contest={contest} nodes={node.children} depth={depth + 1} />
          </details>
        </li>
      ),
    )
  }
</ol>

<script>
  import {
    CATALOG_GROUPS_STORAGE_KEY,
    parseCollapsedGroups,
    serializeCollapsedGroups,
  } from '../lib/catalog-groups';

  document
    .querySelectorAll<HTMLElement>('[data-subject-tree-controls]:not([data-subject-tree-ready])')
    .forEach((controls) => {
      const button = controls.querySelector<HTMLButtonElement>('[data-subject-tree-toggle]');
      const treeId = button?.getAttribute('aria-controls');
      const tree = treeId ? document.getElementById(treeId) : null;
      const groups = tree
        ? Array.from(
            tree.querySelectorAll<HTMLDetailsElement>('details.subject-group-section[data-group-id]'),
          )
        : [];
      if (!button || groups.length === 0) return;

      const groupIds = groups.flatMap((details) =>
        details.dataset.groupId ? [details.dataset.groupId] : [],
      );
      let restored: Set<string> | null = null;
      try {
        restored = parseCollapsedGroups(localStorage.getItem(CATALOG_GROUPS_STORAGE_KEY));
      } catch {
        restored = null;
      }
      const collapsed = restored ?? new Set(groupIds);

      for (const details of groups) {
        const id = details.dataset.groupId;
        if (id) details.open = !collapsed.has(id);
      }

      const persist = () => {
        try {
          localStorage.setItem(CATALOG_GROUPS_STORAGE_KEY, serializeCollapsedGroups(collapsed));
        } catch {
          // Sem localStorage gravável (modo privado, quota): apenas não persiste.
        }
      };

      const renderControl = () => {
        button.textContent = groups.every((details) => details.open)
          ? 'Recolher tudo'
          : 'Expandir tudo';
      };

      for (const details of groups) {
        details.addEventListener('toggle', () => {
          const id = details.dataset.groupId;
          if (!id) return;
          const shouldCollapse = !details.open;
          if (collapsed.has(id) === shouldCollapse) {
            renderControl();
            return;
          }
          if (shouldCollapse) collapsed.add(id);
          else collapsed.delete(id);
          persist();
          renderControl();
        });
      }

      button.addEventListener('click', () => {
        const expand = !groups.every((details) => details.open);
        for (const id of groupIds) {
          if (expand) collapsed.delete(id);
          else collapsed.add(id);
        }
        for (const details of groups) details.open = expand;
        persist();
        renderControl();
      });

      renderControl();
      controls.hidden = false;
      controls.dataset.subjectTreeReady = '';
    });
</script>

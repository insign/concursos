---
interface Props {
  contestStorageId: string;
  contestTitle: string;
}

const { contestStorageId, contestTitle } = Astro.props;
const manifestUrl = `/offline-inventories/${contestStorageId}.json`;
const mediaInventoryUrl = `/offline-media/${contestStorageId}.json`;
---

<section
  class="offline-package print-hidden"
  data-offline-package
  data-contest-storage-id={contestStorageId}
  data-contest-title={contestTitle}
  data-manifest-url={manifestUrl}
  aria-labelledby={`offline-title-${contestStorageId}`}
>
  <div>
    <p class="eyebrow">Acesso sem conexão</p>
    <h2 id={`offline-title-${contestStorageId}`}>Levar este concurso</h2>
    <p data-offline-description>Baixe conteúdos, resumos e questões para estudar offline.</p>
  </div>
  <div class="offline-package-actions">
    <button class="button" type="button" data-offline-download>Baixar concurso</button>
    <div class="offline-media-choice" data-offline-media-choice hidden>
      <label for={`offline-media-select-${contestStorageId}`}>Incluir mídias no download</label>
      <select
        id={`offline-media-select-${contestStorageId}`}
        data-offline-media-select
        aria-describedby={`offline-media-hint-${contestStorageId}`}
      >
        <option value="none">Somente o curso</option>
        <option value="all" data-offline-media-option>Curso + mídias</option>
      </select>
      <p id={`offline-media-hint-${contestStorageId}`} data-offline-media-hint></p>
    </div>
    <button class="button button-secondary" type="button" data-offline-remove hidden>Remover download</button>
    <progress data-offline-progress value="0" max="1" hidden>0%</progress>
    <p data-offline-message role="status" aria-live="polite">Verificando disponibilidade...</p>
  </div>
</section>

<script>
  import {
    downloadContestPackage,
    getOfflineContestRecord,
    markOfflineMediaIncomplete,
    offlinePackageManifestSchema,
    removeContestPackage,
    type OfflinePackageManifest,
  } from '../lib/offline-packages';
  import { subscribeDownloadEvents } from '../lib/offline-download-events';
  import { evaluateOfflineAvailability } from '../lib/offline-availability';
  import {
    mediaUrlsInCache,
    offlineMediaInventorySchema,
    OfflineMediaError,
    type OfflineMediaInventory,
  } from '../lib/offline-media';

  function formatBytes(bytes: number | null): string {
    if (bytes === null) return '';
    if (bytes < 1024 * 1024) return `${Math.ceil(bytes / 1024)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  document.querySelectorAll<HTMLElement>('[data-offline-package]').forEach((root) => {
    const contestStorageId = root.dataset.contestStorageId!;
    const contestTitle = root.dataset.contestTitle!;
    const manifestUrl = root.dataset.manifestUrl!;
    const downloadButton = root.querySelector<HTMLButtonElement>('[data-offline-download]')!;
    const removeButton = root.querySelector<HTMLButtonElement>('[data-offline-remove]')!;
    const progress = root.querySelector<HTMLProgressElement>('[data-offline-progress]')!;
    const message = root.querySelector<HTMLElement>('[data-offline-message]')!;
    const mediaChoice = root.querySelector<HTMLElement>('[data-offline-media-choice]')!;
    const mediaSelect = root.querySelector<HTMLSelectElement>('[data-offline-media-select]')!;
    const mediaOption = root.querySelector<HTMLOptionElement>('[data-offline-media-option]')!;
    const mediaHint = root.querySelector<HTMLElement>('[data-offline-media-hint]')!;
    let latestManifest: OfflinePackageManifest | undefined;
    let mediaInventory: OfflineMediaInventory | undefined;
    let mediaInventoryPromise: Promise<OfflineMediaInventory | undefined> | undefined;
    let mediaInventoryFailed = false;
    let mediaChoiceTouched = false;
    let renderSeq = 0;

    const loadManifest = async () => {
      const response = await fetch(manifestUrl, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Inventário indisponível: HTTP ${response.status}`);
      return offlinePackageManifestSchema.parse(await response.json());
    };

    /**
     * Inventário de mídias do concurso. É opcional: quando não existe (ou
     * falha), o download do curso continua funcionando sem mídias.
     */
    const loadMediaInventory = (): Promise<OfflineMediaInventory | undefined> => {
      // A promessa e memorizada: renders concorrentes aguardam a mesma
      // leitura, em vez de uma delas receber um inventario ainda vazio.
      if (!mediaInventoryPromise) {
        mediaInventoryPromise = (async () => {
          // A falha e avaliada por tentativa: uma falha antiga nao pode
          // impedir que um 404 posterior seja memorizado.
          mediaInventoryFailed = false;
          try {
            const response = await fetch(`/offline-media/${contestStorageId}.json`, { cache: 'no-store' });
            if (!response.ok) {
              // 404 e ausencia de midia (o concurso nao tem audio), nao
              // falha: o resultado e estavel e pode ser memorizado.
              if (response.status !== 404 && response.status !== 410) mediaInventoryFailed = true;
              return undefined;
            }
            const parsed = offlineMediaInventorySchema.safeParse(await response.json());
            if (!parsed.success) {
              mediaInventoryFailed = true;
              return undefined;
            }
            if (parsed.data.contestStorageId !== contestStorageId) {
              // O inventario tem que ser deste concurso.
              mediaInventoryFailed = true;
              return undefined;
            }
            mediaInventory = parsed.data;
          } catch {
            mediaInventoryFailed = true;
            mediaInventory = undefined;
          }
          return mediaInventory;
        })().finally(() => {
          // A falha nao pode ficar memorizada pela vida da pagina: a
          // proxima renderizacao (online, foco, novo clique) precisa
          // tentar de novo.
          if (mediaInventoryFailed) mediaInventoryPromise = undefined;
        });
      }
      return mediaInventoryPromise;
    };

    const formatMediaSize = (bytes: number): string => {
      if (bytes >= 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024 * 1024)).toFixed(1)} GB`;
      return `${Math.max(1, Math.round(bytes / (1024 * 1024)))} MB`;
    };

    const renderMediaChoice = (record: Awaited<ReturnType<typeof getOfflineContestRecord>>) => {
      const hasMedia = Boolean(mediaInventory && mediaInventory.items.length > 0);
      mediaChoice.hidden = !hasMedia;
      if (!hasMedia) return;
      const count = mediaInventory!.items.length;
      mediaOption.textContent = `Curso + mídias (${count} ${count === 1 ? 'arquivo' : 'arquivos'}, ${formatMediaSize(mediaInventory!.estimatedBytes)})`;
      const included = record?.media?.included === true;
      // Depois que o usuario escolhe, a escolha dele manda: uma renderizacao
      // posterior nao pode voltar o controle para o padrao.
      if (!mediaChoiceTouched) mediaSelect.value = included ? 'all' : 'none';
      mediaHint.textContent = included
        ? 'As mídias ficam no aparelho para tocar sem conexão. O tamanho conta no armazenamento do navegador.'
        : 'As mídias aumentam o download e o espaço usado no aparelho.';
    };

    let currentRecord: Awaited<ReturnType<typeof getOfflineContestRecord>>;
    let currentStatus: 'not-downloaded' | 'downloaded' | 'update-available' | 'ghost-package' = 'not-downloaded';
    /** Midia do registro que nao esta mais no cache do aparelho. */
    let mediaMissingFiles = 0;

    /**
     * Estado dos botoes e da mensagem. A midia e uma segunda etapa do
     * mesmo download: o conteudo e o pacote, a midia e o que o usuario
     * marcou no select.
     */
    const renderActions = (): void => {
      const media = currentRecord?.media;
      const mediaComplete = media?.included === true && media.status === 'complete';
      const mediaPartial = media?.included === true && media.status === 'partial';
      const wantsMedia = mediaSelect.value === 'all' && Boolean(mediaInventory && mediaInventory.items.length > 0);

      if (currentStatus === 'not-downloaded') {
        downloadButton.hidden = false;
        downloadButton.textContent = 'Baixar concurso';
        removeButton.hidden = true;
        message.textContent = 'Este concurso ainda não foi baixado.';
        return;
      }
      if (currentStatus === 'ghost-package') {
        downloadButton.hidden = false;
        downloadButton.textContent = 'Baixar concurso';
        removeButton.hidden = true;
        message.textContent = 'O pacote offline não está mais armazenado neste dispositivo. Baixe novamente.';
        return;
      }
      if (currentStatus === 'update-available') {
        downloadButton.hidden = false;
        downloadButton.textContent = 'Atualizar download';
        removeButton.hidden = false;
        message.textContent = 'Há uma atualização disponível. O pacote atual será preservado até o novo ficar pronto.';
        return;
      }

      // O inventario carregado difere do registrado: há mídia nova a
      // baixar.
      const mediaOutdated = Boolean(
        media?.included === true && mediaInventory && mediaInventory.inventoryHash !== media.inventoryHash,
      );
      // O navegador pode expulsar o cache: a mídia precisa ser rebaixada
      // para que o reparo volte a ser oferecido.
      const mediaIncomplete = mediaPartial || mediaOutdated || mediaMissingFiles > 0;

      if (wantsMedia && (!mediaComplete || mediaIncomplete)) {
        downloadButton.hidden = false;
        downloadButton.textContent = 'Baixar mídias';
        removeButton.hidden = false;
        message.textContent = mediaIncomplete
          ? 'O conteúdo está disponível offline, mas as mídias precisam ser completadas. Toque em Baixar mídias para tentar de novo.'
          : 'O conteúdo está disponível offline. Toque em Baixar mídias para baixar os arquivos de áudio.';
        return;
      }

      downloadButton.hidden = true;
      removeButton.hidden = false;
      if (mediaIncomplete) {
        message.textContent =
          'O conteúdo está disponível offline, mas as mídias não foram concluídas. Marque a opção de mídias para tentá-las de novo.';
        return;
      }
      message.textContent = mediaComplete
        ? `Disponível offline com mídias desde ${new Date(currentRecord!.downloadedAt).toLocaleDateString('pt-BR')}.`
        : `Disponível offline desde ${new Date(currentRecord!.downloadedAt).toLocaleDateString('pt-BR')}.`;
    };

    /**
     * Mostra a causa da falha depois de repintar o estado real: a
     * renderizacao reescreve a mensagem e o diagnostico precisa vir por
     * ultimo.
     */
    const showFailure = async (detail: string): Promise<void> => {
      await renderAvailability();
      message.textContent = detail;
    };

    const renderAvailability = async () => {
      const seq = ++renderSeq;
      const record = await getOfflineContestRecord(contestStorageId);
      let cachePresent = true;
      if (record) {
        try {
          if ('caches' in window) cachePresent = await caches.has(record.activeCacheName);
        } catch {
          cachePresent = true;
        }
      }
      let currentHash: string | null | undefined = undefined;
      let loadError = false;
      if (record) {
        try {
          const manifest = await loadManifest();
          latestManifest = manifest;
          currentHash = manifest.manifestHash;
        } catch {
          loadError = true;
          currentHash = null;
        }
      } else {
        latestManifest = undefined;
      }

      await loadMediaInventory();

      if (seq !== renderSeq) return;
      currentRecord = record;
      mediaMissingFiles = 0;
      if (record?.media?.included && record.media.urls.length > 0) {
        const stored = await mediaUrlsInCache(record.media.urls).catch(() => record.media!.urls);
        const missing = record.media.urls.length - stored.length;
        if (missing > 0) {
          mediaMissingFiles = missing;
          if (record.media.status === 'complete') {
            // O cache pode ser expulso pelo navegador: o estado honesto é
            // parcial. A gravacao acontece sob o lock global, com
            // releitura do registro; a interface so reflete o estado.
            currentRecord = { ...record, media: { ...record.media, status: 'partial' as const } };
            void markOfflineMediaIncomplete(contestStorageId).catch(() => undefined);
          }
        }
      }
      renderMediaChoice(currentRecord);

      if (!record) {
        currentStatus = 'not-downloaded';
        downloadButton.disabled = false;
        renderActions();
        return;
      }

      if (!cachePresent) {
        currentStatus = 'ghost-package';
        downloadButton.disabled = false;
        renderActions();
        return;
      }

      if (loadError) {
        currentStatus = 'downloaded';
        downloadButton.disabled = false;
        downloadButton.hidden = true;
        removeButton.hidden = false;
        message.textContent = `Disponível offline desde ${new Date(record.downloadedAt).toLocaleDateString('pt-BR')}.`;
        return;
      }

      const avail = evaluateOfflineAvailability({
        hasRecord: true,
        recordManifestHash: record.manifestHash,
        currentManifestHash: currentHash,
        cachePresent,
      });
      currentStatus =
        avail.status === 'update-available'
          ? 'update-available'
          : avail.status === 'ghost-package'
            ? 'ghost-package'
            : 'downloaded';
      downloadButton.disabled = false;
      renderActions();
    };

    mediaSelect.addEventListener('change', () => {
      mediaChoiceTouched = true;
      renderActions();
    });

    downloadButton.addEventListener('click', async () => {
      if (typeof navigator !== 'undefined' && navigator.onLine === false) {
        message.textContent = 'Sem conexão à internet. Conecte-se para baixar o concurso.';
        return;
      }
      downloadButton.disabled = true;
      removeButton.disabled = true;
      mediaSelect.disabled = true;
      progress.hidden = false;
      message.textContent = 'Preparando o download...';
      try {
        const manifest: OfflinePackageManifest = latestManifest ?? await loadManifest();
        const size = typeof manifest.estimatedBytes === 'number' ? formatBytes(manifest.estimatedBytes) : '';
        const includeMedia = mediaSelect.value === 'all' && Boolean(mediaInventory && mediaInventory.items.length > 0);
        const media = includeMedia ? mediaInventory : undefined;
        message.textContent = media
          ? `Baixando o curso e ${media!.items.length} mídias...`
          : size
            ? `Baixando aproximadamente ${size}...`
            : 'Baixando concurso...';
        await downloadContestPackage(
          manifest,
          ({ completed, total, fetched, copied }) => {
            progress.max = total;
            progress.value = completed;
            if (fetched !== undefined && copied !== undefined && copied > 0) {
              message.textContent = `Atualizando ${fetched} novos de ${total} (${copied} copiados)${size ? `, cerca de ${size}` : ''}...`;
            } else {
              message.textContent = `Baixando ${completed} de ${total} recursos${size ? `, cerca de ${size}` : ''}...`;
            }
          },
          undefined,
          'download',
          media ? { media } : {},
        );
        window.dispatchEvent(new CustomEvent('concursos:offline-packages-changed'));
        await renderAvailability();
      } catch (error) {
        const detail = error instanceof Error ? error.message : 'Não foi possível concluir o download.';
        await showFailure(
          error instanceof OfflineMediaError ? `As mídias não foram concluídas: ${detail}` : detail,
        );
      } finally {
        mediaSelect.disabled = false;
        downloadButton.disabled = false;
        removeButton.disabled = false;
        progress.hidden = true;
      }
    });

    removeButton.addEventListener('click', async () => {
      if (!window.confirm(`Remover o pacote offline de ${contestTitle}?`)) return;
      removeButton.disabled = true;
      message.textContent = 'Removendo download...';
      try {
        await removeContestPackage(contestStorageId);
        window.dispatchEvent(new CustomEvent('concursos:offline-packages-changed'));
        await renderAvailability();
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : 'Não foi possível remover o download.';
      } finally {
        removeButton.disabled = false;
      }
    });

    if (!('caches' in window)) {
      downloadButton.disabled = true;
      message.textContent = 'Este navegador não oferece armazenamento offline compatível.';
    } else {
      void renderAvailability();
      const refreshOnVisible = () => {
        if (document.visibilityState === 'visible') void renderAvailability();
      };
      document.addEventListener('visibilitychange', refreshOnVisible);
      window.addEventListener('online', () => void renderAvailability());
      window.addEventListener('offline', () => void renderAvailability());
      window.addEventListener('pageshow', () => void renderAvailability());
      window.addEventListener('concursos:offline-packages-changed', () => void renderAvailability());
    }

    subscribeDownloadEvents((event) => {
      if (event.contestStorageId !== contestStorageId) return;
      if (event.phase === 'media') {
        if (event.type === 'started') {
          message.textContent = 'Baixando mídias...';
        } else if (event.type === 'progress') {
          progress.hidden = false;
          progress.max = event.total;
          progress.value = event.completed;
          message.textContent = `Baixando ${event.completed} de ${event.total} mídias...`;
        } else if (event.type === 'failed') {
          progress.hidden = true;
          void showFailure(`As mídias não foram concluídas: ${event.message}`);
        } else if (event.type === 'completed') {
          progress.hidden = true;
          window.dispatchEvent(new CustomEvent('concursos:offline-packages-changed'));
          void renderAvailability();
        }
        return;
      }
      if (event.phase === 'download') {
        if (event.type === 'started') {
          downloadButton.disabled = true;
          message.textContent = 'Baixando concurso...';
        } else if (event.type === 'completed') {
          window.dispatchEvent(new CustomEvent('concursos:offline-packages-changed'));
          void renderAvailability();
        } else if (event.type === 'failed') {
          downloadButton.disabled = false;
          progress.hidden = true;
          void showFailure(event.message);
        } else if (event.type === 'progress') {
          progress.hidden = false;
          progress.max = event.total;
          progress.value = event.completed;
          message.textContent = `Baixando ${event.completed} de ${event.total} recursos...`;
        }
        return;
      }
      if (event.type === 'started') {
        downloadButton.disabled = true;
        message.textContent = 'Há uma atualização do pacote. Atualizando automaticamente...';
        return;
      }
      if (event.type === 'progress') {
        progress.hidden = false;
        progress.max = event.total;
        progress.value = event.completed;
        message.textContent = `Atualizando ${event.completed} de ${event.total} recursos...`;
        return;
      }
      downloadButton.disabled = false;
      progress.hidden = true;
      if (event.type === 'completed') {
        window.dispatchEvent(new CustomEvent('concursos:offline-packages-changed'));
      }
      void renderAvailability();
    });
  });
</script>

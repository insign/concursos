---
import type { SubjectMediaItem } from '../lib/catalog';
import { studiedSubjectId } from '../lib/studied';

interface Props {
  items: SubjectMediaItem[];
  contestStorageId: string;
  subjectStorageId: string;
  mediaKey: string;
}

const { items, contestStorageId, subjectStorageId, mediaKey } = Astro.props;
const first = items[0];
if (!first) {
  throw new Error('SubjectMedia exige ao menos uma mídia');
}
const hasMultiple = items.length > 1;
const hasMixedKinds = items.some((item) => item.kind !== first.kind);
const subjectId = studiedSubjectId(contestStorageId, subjectStorageId);
---

<section
  class="subject-media print-hidden"
  aria-label={hasMultiple ? 'Mídias do assunto' : first.kind === 'video' ? 'Vídeo do assunto' : 'Áudio do assunto'}
  data-subject-media
  data-subject-media-key={mediaKey}
  data-subject-media-subject-id={subjectId}
  data-subject-media-contest-id={contestStorageId}
  data-subject-media-subject-storage-id={subjectStorageId}
>
  <div class="subject-media-player">
    <button type="button" class="subject-media-play" data-subject-media-play>
      {hasMixedKinds ? 'Reproduzir mídia do assunto' : first.kind === 'video' ? 'Assistir vídeo do assunto' : 'Ouvir áudio do assunto'}
    </button>
    {
      first.kind === 'video' ? (
        <video
          data-subject-media-source
          data-media-id={first.id}
          data-media-url={first.url}
          data-media-kind={first.kind}
          data-media-label={first.label}
          hidden
          preload="none"
          playsinline
        />
      ) : (
        <audio
          data-subject-media-source
          data-media-id={first.id}
          data-media-url={first.url}
          data-media-kind={first.kind}
          data-media-label={first.label}
          hidden
          preload="none"
        />
      )
    }
  </div>
  {
    hasMultiple && (
      <div class="subject-media-selector">
        <label for="subject-media-select">Escolher mídia</label>
        <select id="subject-media-select" data-subject-media-select>
          {items.map((item) => (
            <option
              value={item.id}
              data-media-id={item.id}
              data-media-url={item.url}
              data-media-kind={item.kind}
              data-media-label={item.label}
            >
              {item.label}
            </option>
          ))}
        </select>
      </div>
    )
  }
  <div class="subject-media-status" role="status" aria-live="polite" data-subject-media-status />
  <div class="subject-media-toast" data-subject-media-toast hidden>
    <div class="subject-media-toast-text" data-subject-media-toast-text />
    <button type="button" class="subject-media-toast-action" data-subject-media-toast-action />
    <button
      type="button"
      class="subject-media-toast-dismiss"
      data-subject-media-toast-dismiss
      aria-label="Fechar aviso"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <noscript>
    <ul class="subject-media-noscript">
      {items.map((item) => (
        <li>
          <a href={item.url}>{item.label}</a>
        </li>
      ))}
    </ul>
  </noscript>
</section>

<script>
  import { onPageMount, PageScope } from '../lib/page-lifecycle';
  import { selectGlobalMedia, revealGlobalMedia } from '../lib/global-media-player';
  import { registerLocalStateFlusher } from '../lib/local-durability';
  import {
    loadMediaDocument,
    loadRemoteMediaDocument,
    resolveMediaContext,
    saveMediaPosition,
    saveMediaSelection,
  } from '../lib/media-client';
  import {
    completionRatioReached,
    resolveResumePosition,
    shouldMarkSubjectStudied,
    shouldPersistPosition,
  } from '../lib/media-state';
  import { isStudied, loadStudied, setSubjectStudied } from '../lib/studied';
  import { requestProfileSync } from '../lib/sync';

  interface MediaItem {
    id: string;
    url: string;
    kind: 'audio' | 'video';
    label: string;
  }

  const RESUME_MIN_SECONDS = 5;
  const RESUME_TAIL_SECONDS = 15;
  const SAVE_INTERVAL_SECONDS = 5;
  const SYNC_INTERVAL_MS = 60_000;
  const INITIAL_LOAD_TIMEOUT_MS = 1500;
  const TOAST_TIMEOUT_MS = 8000;

  function readItem(source: HTMLElement): MediaItem | null {
    const id = source.dataset.mediaId;
    const url = source.dataset.mediaUrl;
    const kind = source.dataset.mediaKind;
    const label = source.dataset.mediaLabel;
    if (!id || !url || (kind !== 'audio' && kind !== 'video') || !label) return null;
    return { id, url, kind, label };
  }

  function formatTime(seconds: number): string {
    const total = Math.max(0, Math.floor(seconds));
    const minutes = Math.floor(total / 60);
    const rest = total % 60;
    return `${minutes}:${String(rest).padStart(2, '0')}`;
  }

  let session: { key: string; selected: () => string; select: (id: string) => void; play: () => void; dispose: () => void } | null = null;
  onPageMount((scope) => {
    for (const section of document.querySelectorAll<HTMLElement>('[data-subject-media]')) {
      const key = section.dataset.subjectMediaKey ?? '';
      const activate = () => {
        if (session?.key !== key) {
          session?.dispose();
          session = setupSubjectMedia(section);
        }
        return session;
      };
      if (!session) activate();
      const select = section.querySelector<HTMLSelectElement>('[data-subject-media-select]');
      if (select && session?.key === key) select.value = session.selected();
      scope.on(section.querySelector<HTMLButtonElement>('[data-subject-media-play]')!, 'click', () => {
        const current = activate();
        if (select) current?.select(select.value);
        current?.play();
      });
      if (select) scope.on(select, 'change', () => { activate()?.select(select.value); });
    }
  });

  function setupSubjectMedia(section: HTMLElement): typeof session {
    const scope = new PageScope();
    const host = document.getElementById('global-media-player')!;
    const initialElement = section.querySelector<HTMLMediaElement>('[data-subject-media-source]');
    if (!initialElement) return null;
    const title = document.querySelector('.subject-title, h1')?.textContent?.trim() ?? 'Mídia do assunto';
    const href = location.pathname;
    const state = { element: selectGlobalMedia(initialElement.dataset.mediaKind === 'video' ? 'video' : 'audio', title, href) };
    const select = section.querySelector<HTMLSelectElement>('[data-subject-media-select]');
    const status = host.querySelector<HTMLElement>('[data-subject-media-status]');
    const toast = host.querySelector<HTMLElement>('[data-subject-media-toast]');
    const toastText = host.querySelector<HTMLElement>('[data-subject-media-toast-text]');
    const toastAction = host.querySelector<HTMLButtonElement>('[data-subject-media-toast-action]');
    const toastDismiss = host.querySelector<HTMLButtonElement>('[data-subject-media-toast-dismiss]');
    if (status) status.textContent = '';
    if (toast) toast.hidden = true;

    const mediaKey = section.dataset.subjectMediaKey ?? '';
    const subjectId = section.dataset.subjectMediaSubjectId ?? '';
    const contestStorageId = section.dataset.subjectMediaContestId ?? '';
    const subjectStorageId = section.dataset.subjectMediaSubjectStorageId ?? '';
    const context = resolveMediaContext(mediaKey);
    const profileId = context.profileId;

    const items = new Map<string, MediaItem>();
    const first = readItem(initialElement);
    if (first) items.set(first.id, first);
    select?.querySelectorAll('option').forEach((option) => {
      const item = readItem(option);
      if (item) items.set(item.id, item);
    });

    let statusTimer: ReturnType<typeof setTimeout> | undefined;
    scope.defer(() => clearTimeout(statusTimer));
    const setStatus = (message: string, clearAfterMs = 0) => {
      clearTimeout(statusTimer);
      if (scope.signal.aborted || !status) return;
      status.textContent = message;
      if (clearAfterMs > 0) {
        statusTimer = setTimeout(() => {
          if (status.textContent === message) status.textContent = '';
        }, clearAfterMs);
      }
    };

    if (!profileId) {
      setStatus('A reprodução funciona, mas a posição não é salva sem um alias em Configurações.');
    }

    let selectedId = first?.id ?? '';
    let lastSavedSeconds = 0;
    let lastSyncAt = 0;
    let completed = new Set<string>();
    const completing = new Set<string>();
    /** Posições conhecidas nesta sessão, por mídia. */
    const positions = new Map<string, number>();
    let pendingPosition: number | null = null;
    /** O usuário interagiu com a faixa atual: impede que uma resposta tardia pule a reprodução. */
    let userStarted = false;
    let firstWriteDone = false;
    let toastTimer: number | null = null;
    scope.defer(() => { if (toastTimer !== null) clearTimeout(toastTimer); });

    const activeItem = () => items.get(selectedId) ?? first ?? null;

    const requestSync = (): void => {
      if (!profileId) return;
      const now = Date.now();
      if (now - lastSyncAt < SYNC_INTERVAL_MS) return;
      lastSyncAt = now;
      void requestProfileSync(profileId);
    };

    /**
     * Leitura remota inicial do documento do assunto. É feita uma única vez e
     * nunca rejeita: sem linhagem remota conhecida, publicar um documento
     * quase vazio apagaria as posições dos outros aparelhos.
     */
    let initialLoad: Promise<void> | null = null;
    const ensureInitialLoad = (): Promise<void> => {
      if (!initialLoad) {
        initialLoad = loadRemoteMediaDocument(context).catch(() => undefined);
      }
      return initialLoad;
    };

    const persist = async (force: boolean, trackActivity = true): Promise<void> => {
      const duration = state.element.duration;
      const position = state.element.currentTime;
      if (!Number.isFinite(duration) || duration <= 0) return;
      if (!Number.isFinite(position) || position < 0) return;
      if (!force && !shouldPersistPosition(position, lastSavedSeconds, SAVE_INTERVAL_SECONDS)) return;
      const item = activeItem();
      if (!item) return;
      if (!firstWriteDone) {
        await Promise.race([
          ensureInitialLoad(),
          new Promise((resolve) => window.setTimeout(resolve, INITIAL_LOAD_TIMEOUT_MS)),
        ]);
        firstWriteDone = true;
      }
      try {
        await saveMediaPosition(context, contestStorageId, subjectStorageId, item.id, {
          positionSeconds: position,
          durationSeconds: duration,
          completed: completed.has(item.id),
        }, trackActivity);
        if (selectedId === item.id) lastSavedSeconds = position;
        positions.set(item.id, position);
        requestSync();
      } catch (error) {
        // Falha local não interrompe a reprodução: `lastSavedSeconds` fica no
        // valor anterior para que a próxima tentativa ocorra em breve.
        if (force) throw error;
      }
    };

    const showToast = (message: string, actionLabel: string, onAction: () => void) => {
      if (scope.signal.aborted || !toast || !toastText || !toastAction) return;
      revealGlobalMedia();
      toastText.textContent = message;
      toastAction.textContent = actionLabel;
      toastAction.hidden = false;
      toast.hidden = false;
      if (toastTimer !== null) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
        toastTimer = null;
      }, TOAST_TIMEOUT_MS);
      toastAction.onclick = () => {
        if (toastTimer !== null) window.clearTimeout(toastTimer);
        toastTimer = null;
        toast.hidden = true;
        onAction();
      };
      if (toastDismiss) {
        toastDismiss.onclick = () => {
          if (toastTimer !== null) window.clearTimeout(toastTimer);
          toastTimer = null;
          toast.hidden = true;
        };
      }
    };

    const announceStudied = (studied: boolean) => {
      window.dispatchEvent(
        new CustomEvent('concursos:studied-updated', {
          detail: { profileId, contestStorageId, subjectStorageId, studied },
        }),
      );
    };

    const markCompleted = async (mediaId: string, duration: number): Promise<void> => {
      if (completed.has(mediaId) || completing.has(mediaId)) return;
      completing.add(mediaId);
      try {
        await saveMediaPosition(context, contestStorageId, subjectStorageId, mediaId, {
          positionSeconds: duration,
          durationSeconds: duration,
          completed: true,
        });
        completed.add(mediaId);
        positions.set(mediaId, duration);
        if (!profileId) return;

        const document_ = await loadMediaDocument(context);
        const completedCount = [...items.keys()].filter(
          (id) => document_?.positions[id]?.completed === true,
        ).length;
        const alreadyStudied = isStudied(await loadStudied(profileId), subjectId);
        if (!shouldMarkSubjectStudied({ itemCount: items.size, completedCount, alreadyStudied })) return;

        await setSubjectStudied(profileId, subjectId, true);
        announceStudied(true);
        showToast('Assunto marcado como concluído.', 'Desfazer', () => {
          void (async () => {
            await setSubjectStudied(profileId, subjectId, false);
            announceStudied(false);
            window.dispatchEvent(new Event('concursos:subject-unread'));
            void requestProfileSync(profileId);
          })();
        });
        void requestProfileSync(profileId);
      } catch {
        // A marcação de conclusão é uma cortesia: se a gravação falhar, o
        // assunto continua estudável pelo botão manual e a próxima
        // atualização tenta de novo.
      } finally {
        completing.delete(mediaId);
      }
    };

    const saveSelection = (id: string) => {
      void ensureInitialLoad().then(() => {
        if (!scope.signal.aborted && selectedId === id) return saveMediaSelection(context, contestStorageId, subjectStorageId, id);
      }).catch(() => setStatus('Não foi possível salvar a seleção da mídia.'));
    };

    const applyItem = (item: MediaItem): void => {
      selectedId = item.id;
      // A guarda de retomada vale para a faixa atual: ao trocar de faixa, a
      // nova pode e deve ser retomada do ponto salvo.
      userStarted = false;
      for (const currentSection of document.querySelectorAll<HTMLElement>('[data-subject-media]')) {
        if (currentSection.dataset.subjectMediaKey !== mediaKey) continue;
        const currentSelect = currentSection.querySelector<HTMLSelectElement>('[data-subject-media-select]');
        if (currentSelect) currentSelect.value = item.id;
      }
      state.element.pause();
      state.element.removeAttribute('data-subject-media-element');
      state.element = selectGlobalMedia(item.kind, `${title} — ${item.label}`, href);
      state.element.setAttribute('data-subject-media-element', '');
      state.element.dataset.mediaKind = item.kind;
      state.element.dataset.mediaId = item.id;
      state.element.src = item.url;
      lastSavedSeconds = 0;
      pendingPosition = positions.get(item.id) ?? null;
    };

    const restore = (): void => {
      if (scope.signal.aborted || pendingPosition === null || userStarted) return;
      const duration = state.element.duration;
      // Sem metadados carregados ainda, a posição fica pendente: o
      // `loadedmetadata` tenta de novo.
      if (!Number.isFinite(duration) || duration <= 0) return;
      const position = resolveResumePosition({
        positionSeconds: pendingPosition,
        durationSeconds: duration,
        minSeconds: RESUME_MIN_SECONDS,
        tailSeconds: RESUME_TAIL_SECONDS,
      });
      pendingPosition = null;
      if (position === null) return;
      state.element.currentTime = position;
      setStatus(`Retomando de ${formatTime(position)}.`, 10_000);
    };

    // Os eventos de HTMLMediaElement não borbulham; a fase de captura os
    // alcança no elemento de mídia mesmo quando o listener está na section.
    scope.on(host, 'loadedmetadata', restore, { capture: true });
    scope.on(host, 'durationchange', restore, { capture: true });
    scope.on(host,
      'play',
      () => {
        userStarted = true;
      },
      { capture: true },
    );
    scope.on(host,
      'timeupdate',
      () => {
        void persist(false);
        const duration = state.element.duration;
        const position = state.element.currentTime;
        const item = activeItem();
        if (!item) return;
        if (completionRatioReached(position, duration)) {
          void markCompleted(item.id, duration);
        }
      },
      { capture: true },
    );
    scope.on(host,
      'pause',
      () => {
        void persist(true).catch(() => setStatus('Não foi possível salvar a posição.'));
        requestSync();
      },
      { capture: true },
    );
    scope.on(host,
      'ended',
      () => {
        void persist(true).catch(() => setStatus('Não foi possível salvar a posição.'));
        const item = activeItem();
        const duration = state.element.duration;
        if (item && Number.isFinite(duration)) {
          void markCompleted(item.id, duration);
        }
      },
      { capture: true },
    );
    scope.on(host,
      'error',
      () => {
        setStatus('Mídia indisponível. O arquivo é servido pelo armazenamento de mídia.');
      },
      { capture: true },
    );

    scope.on(document, 'visibilitychange', () => {
      if (document.visibilityState === 'hidden') void persist(true).catch(() => undefined);
    });
    scope.on(window, 'pagehide', () => {
      void persist(true).catch(() => undefined);
    });

    // O flusher grava apenas o que mudou de fato: a barreira de atualização da
    // PWA (ADR-003) espera a revisão de atividade estabilizar.
    // O motor sobrevive ao swap: seus snapshots de flush não geram nova revisão
    // a cada avanço do relógio, que impediria a barreira de estabilizar tocando.
    scope.defer(registerLocalStateFlusher(() => persist(true, false)));
    if (first) applyItem(first);

    void (async () => {
      try {
        const local = await loadMediaDocument(context);
        if (scope.signal.aborted || userStarted) return;
        if (local) {
          for (const [id, position] of Object.entries(local.positions)) {
            if (position.completed) completed.add(id);
            positions.set(id, position.positionSeconds);
          }
          const preferred = local.selectedMediaId;
          if (preferred && items.has(preferred) && preferred !== selectedId) {
            const item = items.get(preferred);
            if (item) applyItem(item);
          } else {
            pendingPosition = local.positions[selectedId]?.positionSeconds ?? null;
          }
          restore();
        }
        // O documento do assunto é buscado sob demanda: a ativação de alias em
        // um aparelho novo não lê nada de mídia.
        await ensureInitialLoad();
        const refreshed = await loadMediaDocument(context);
        if (scope.signal.aborted || !refreshed) return;
        for (const [id, position] of Object.entries(refreshed.positions)) {
          if (position.completed) completed.add(id);
          positions.set(id, position.positionSeconds);
        }
        if (userStarted) return;
        const remoteSelected = refreshed.selectedMediaId;
        if (remoteSelected && items.has(remoteSelected) && remoteSelected !== selectedId) {
          const item = items.get(remoteSelected);
          if (item) {
            applyItem(item);
            return;
          }
        }
        pendingPosition = refreshed.positions[selectedId]?.positionSeconds ?? null;
        restore();
      } catch {
        // Sem rede ou com documento remoto inválido, a mídia continua
        // reproduzindo com o estado local.
      }
    })();
    return {
      key: mediaKey,
      selected: () => selectedId,
      select(id) {
        if (id === selectedId) return;
        const item = items.get(id);
        if (!item) return;
        // Snapshot antes de trocar src; a escrita mantém o consumidor original.
        void persist(true).catch(() => setStatus('Não foi possível salvar a posição anterior.'));
        applyItem(item);
        saveSelection(item.id);
      },
      play() {
        saveSelection(selectedId);
        revealGlobalMedia();
        if (!state.element.paused) state.element.pause();
        else void state.element.play().catch(() => setStatus('Não foi possível reproduzir a mídia. Tente novamente.'));
      },
      dispose() {
        void persist(true).catch(() => undefined);
        state.element.pause();
        scope.dispose();
      },
    };
  }
</script>

<style>
  .subject-media {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .subject-media-play {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent-strong);
    font: inherit;
    font-family: var(--sans);
    font-weight: 700;
    text-align: left;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .subject-media-play:hover {
    color: var(--signal);
  }

  .subject-media-selector {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .subject-media-selector label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .subject-media-selector select {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--ground);
    color: inherit;
    font: inherit;
  }

  .subject-media-player audio,
  .subject-media-player video {
    width: 100%;
  }

  .subject-media-player video {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .subject-media-status {
    margin: 0.6rem 0 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .subject-media-status:empty {
    display: none;
  }

  .subject-media-toast {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--ground);
    font-size: 0.9rem;
  }

  .subject-media-toast[hidden] {
    display: none;
  }

  .subject-media-toast-text {
    margin: 0;
    flex: 1 1 12rem;
  }

  .subject-media-toast-action {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--field-bg);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .subject-media-toast-dismiss {
    display: inline-flex;
    padding: 0.2rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .subject-media-toast-dismiss svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .subject-media-noscript {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
  }
</style>

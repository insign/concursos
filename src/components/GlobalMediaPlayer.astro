<aside id="global-media-player" class="media-dock print-hidden" transition:persist="global-media-player" aria-label="Player de mídia" hidden>
  <audio data-global-media-audio preload="metadata" />
  <video data-global-media-video preload="metadata" playsinline hidden />
  <div class="media-dock-row">
    <a data-media-title href="/" class="media-dock-title">Mídia do assunto</a>
    <div class="media-dock-controls">
      <button type="button" data-media-back aria-label="Voltar 15 segundos">−15</button>
      <button type="button" data-media-toggle class="media-dock-play" aria-label="Reproduzir">▶</button>
      <button type="button" data-media-forward aria-label="Avançar 15 segundos">+15</button>
      <select class="media-dock-speed" data-media-speed aria-label="Velocidade de reprodução"><option value="0.75">0,75×</option><option value="1" selected>1×</option><option value="1.25">1,25×</option><option value="1.5">1,5×</option><option value="2">2×</option></select>
      <button type="button" data-media-close aria-label="Fechar player">×</button>
    </div>
  </div>
  <div class="media-dock-timeline">
    <output data-media-time>0:00 / 0:00</output>
    <input type="range" data-media-seek aria-label="Posição de reprodução" min="0" max="0" step="1" value="0" disabled />
  </div>
  <div data-subject-media-status role="status" aria-live="polite"></div>
  <div data-subject-media-toast hidden>
    <span data-subject-media-toast-text></span>
    <button type="button" data-subject-media-toast-action>Desfazer</button>
    <button type="button" data-subject-media-toast-dismiss aria-label="Fechar aviso">×</button>
  </div>
</aside>

<script>
  import { startGlobalMediaPlayer } from '../lib/global-media-player';
  startGlobalMediaPlayer();
</script>

<style is:global>
  :root { --media-dock-height: 0px; --media-dock-space: 0px; }
  body { padding-bottom: var(--media-dock-space); }
  .media-dock { position: fixed; inset: auto 0 0; z-index: 110; padding: .65rem max(1rem, env(safe-area-inset-right)) calc(.55rem + env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left)); background: var(--surface, var(--ground)); color: var(--ink); border-top: 1px solid var(--line); box-shadow: 0 -4px 24px #0002; }
  .media-dock[hidden], .media-dock [hidden] { display: none; }
  .media-dock-row { display: flex; align-items: center; gap: .75rem; max-width: 76rem; margin: auto; }
  .media-dock-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .9rem; color: inherit; }
  .media-dock-controls { display: flex; align-items: center; gap: .35rem; }
  .media-dock button, .media-dock select { min-width: 44px; min-height: 44px; border: 0; border-radius: 22px; color: inherit; background: var(--field-bg); font: inherit; cursor: pointer; }
  .media-dock button:focus-visible, .media-dock input:focus-visible, .media-dock select:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .media-dock .media-dock-play { background: var(--accent); color: var(--on-accent, white); font-size: 1.2rem; }
  .media-dock-timeline { display: flex; align-items: center; gap: .75rem; max-width: 76rem; margin: .25rem auto 0; }
  .media-dock-timeline output { font-size: .75rem; font-variant-numeric: tabular-nums; }
  .media-dock-timeline input { flex: 1; min-width: 0; accent-color: var(--accent); min-height: 24px; }
  .media-dock video { width: min(100%, 28rem); max-height: 35vh; margin: 0 auto .4rem; display: block; }
  .media-dock [role='status']:empty { display: none; }
  .media-dock [role='status'], .media-dock [data-subject-media-toast] { font-size: .85rem; max-width: 76rem; margin: .25rem auto 0; }
  .media-dock [data-subject-media-toast] { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  @media (max-width: 520px) { .media-dock-row { flex-wrap: wrap; gap: .25rem; } .media-dock-title { flex-basis: 100%; } .media-dock-controls { width: 100%; justify-content: space-between; } }
  @media print { .media-dock { display: none !important; } body { padding-bottom: 0; } }
</style>

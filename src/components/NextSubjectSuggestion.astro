---
import type { CatalogContest } from '../lib/catalog';
import {
  areAllSubjectsStudied,
  buildSubjectSuggestionModel,
  suggestNextSubject,
} from '../lib/subject-suggestion';

interface Props {
  contest: CatalogContest;
  instanceId: string;
  currentSubjectId?: string | null;
}

const { contest, instanceId, currentSubjectId = null } = Astro.props;
const model = buildSubjectSuggestionModel(contest);
const initialSuggestion = suggestNextSubject(model, [], currentSubjectId, null);
const initialComplete = areAllSubjectsStudied(model, []);
const initialStatus = initialSuggestion
  ? ''
  : initialComplete
    ? 'Todos os assuntos deste concurso foram concluídos.'
    : 'Não há outro assunto pendente para sugerir.';
const componentId = `subject-suggestion-${contest.storageId}-${instanceId}`;
const serializedConfig = JSON.stringify({ model, currentSubjectId, contestStorageId: contest.storageId }).replaceAll('<', '\\u003c');
---

<aside
  id={componentId}
  class="subject-suggestion print-hidden"
  data-subject-suggestion
  data-subject-suggestion-instance={instanceId}
  aria-label="Sugestão de próximo assunto"
>
  <div data-subject-suggestion-content hidden={!initialSuggestion}>
    <p class="eyebrow" id={`${componentId}-label`}>Próxima etapa</p>
    <a
      class="button subject-suggestion-link"
      data-subject-suggestion-link
      href={initialSuggestion?.href ?? `/concursos/${contest.slug}/`}
      aria-describedby={`${componentId}-title`}
    >
      Próximo assunto sugerido
    </a>
    <p class="subject-suggestion-title" id={`${componentId}-title`} data-subject-suggestion-title>
      {initialSuggestion?.title}
    </p>
  </div>
  <p class="subject-suggestion-complete" data-subject-suggestion-status role="status" aria-live="polite">
    {initialStatus}
  </p>
  <script type="application/json" data-subject-suggestion-config set:html={serializedConfig}></script>
</aside>

<script>
  import { getActiveAlias } from '../lib/identity';
  import { loadStudied, studiedSubjectId } from '../lib/studied';
  import { getNavigationRecord } from '../lib/navigation-db';
  import { canResumeReading } from '../lib/navigation';
  import {
    areAllSubjectsStudied,
    suggestNextSubject,
    type SubjectSuggestionModel,
  } from '../lib/subject-suggestion';

  const completionMessage = 'Todos os assuntos deste concurso foram concluídos.';
  const noAlternativeMessage = 'Não há outro assunto pendente para sugerir.';
  interface SuggestionConfig {
    model: SubjectSuggestionModel;
    currentSubjectId: string | null;
    contestStorageId: string;
  }

  const instances = Array.from(
    document.querySelectorAll<HTMLElement>('[data-subject-suggestion]:not([data-suggestion-ready])'),
  ).flatMap((root) => {
    const serialized = root.querySelector<HTMLScriptElement>('[data-subject-suggestion-config]')?.textContent;
    const content = root.querySelector<HTMLElement>('[data-subject-suggestion-content]');
    const link = root.querySelector<HTMLAnchorElement>('[data-subject-suggestion-link]');
    const title = root.querySelector<HTMLElement>('[data-subject-suggestion-title]');
    const status = root.querySelector<HTMLElement>('[data-subject-suggestion-status]');
    if (!serialized || !content || !link || !title || !status) return [];
    root.setAttribute('data-suggestion-ready', '');
    return [{ content, link, title, status, config: JSON.parse(serialized) as SuggestionConfig, root }];
  });

  if (instances.length > 0) {
    const renderAll = async (studiedSubjectIds: Iterable<string>, resumeByContest: Map<string, string | null>) => {
      const studied = [...studiedSubjectIds];
      const lastStudied = studied.length > 0 ? studied[studied.length - 1]! : null;
      instances.forEach(({ config, content, link, title, status }) => {
        let suggestion = suggestNextSubject(config.model, studied, config.currentSubjectId, lastStudied);
        const complete = areAllSubjectsStudied(config.model, studied);
        // Opcao A: ocultar quando sugerido === resume
        const resumeId = resumeByContest.get(config.contestStorageId) ?? null;
        if (suggestion && resumeId && suggestion.studiedSubjectId === resumeId) {
          suggestion = null;
        }
        content.hidden = suggestion === null;
        status.textContent = suggestion === null ? (complete ? completionMessage : noAlternativeMessage) : '';
        if (suggestion) {
          link.setAttribute('href', suggestion.href);
          title.textContent = suggestion.title;
        }
      });
    };

    const alias = getActiveAlias();
    if (alias) {
      let refreshVersion = 0;
      const refresh = async () => {
        const version = ++refreshVersion;
        try {
          const [studiedDoc, navRecord] = await Promise.all([
            loadStudied(alias).catch(() => ({ studiedSubjectIds: [] as string[] })),
            getNavigationRecord(alias).catch(() => null),
          ]);
          if (version !== refreshVersion) return;
          const resumeByContest = new Map<string, string | null>();
          for (const inst of instances) {
            const cid = inst.config.contestStorageId;
            if (!resumeByContest.has(cid)) {
              let rid: string | null = null;
              const cur = navRecord?.current;
              if (cur && canResumeReading(cur, cid)) {
                rid = studiedSubjectId(cur.context.contestStorageId!, cur.context.subjectStorageId!);
              }
              resumeByContest.set(cid, rid);
            }
          }
          if (version !== refreshVersion) return;
          await renderAll(studiedDoc.studiedSubjectIds, resumeByContest);
        } catch {
          // best-effort
        }
      };
      refresh();

      window.addEventListener('concursos:studied-updated', (event) => {
        if ((event as CustomEvent<{ profileId?: string }>).detail?.profileId === alias) refresh();
      });
      window.addEventListener('concursos:sync-status', (event) => {
        const state = (event as CustomEvent<{ state?: string }>).detail?.state;
        if (state === 'synced' || state === 'error') refresh();
      });
      window.addEventListener('concursos:navigation-updated', () => refresh());
      window.addEventListener('concursos:navigation-synced', () => refresh());
    } else {
      // Sem alias: render deterministico ja feito no SSR
    }
  }
</script>

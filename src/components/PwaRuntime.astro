<script>
  import { registerSW } from 'virtual:pwa-register';
  import { getActiveAlias } from '../lib/identity';
  import { cleanupInactiveContestCaches } from '../lib/offline-packages';
  import { browserPwaReloadEnvironment, reloadBypassingCache, type PwaReloadEnvironment } from '../lib/pwa-reload';
  import { createPwaUpdateCheckScheduler } from '../lib/pwa-update-check';
  import { createPwaUpdateController, runAfterLocalWritesSettled, type PwaStatusDetail } from '../lib/pwa-update';
  import { requestCompleteProfileSync } from '../lib/simulados-profile-sync';

  const emit = (detail: PwaStatusDetail) => {
    window.dispatchEvent(new CustomEvent('concursos:pwa-status', { detail }));
  };
  let updateServiceWorker: (reloadPage?: boolean) => Promise<void> = async () => undefined;
  const reloadEnvironment: PwaReloadEnvironment = {
    ...browserPwaReloadEnvironment(),
    settleWrites: () => runAfterLocalWritesSettled(() => undefined),
  };
  const controller = createPwaUpdateController({
    activate: () => updateServiceWorker(true),
    reload: () => reloadBypassingCache(reloadEnvironment, window.location.href),
    emit,
  });
  let swRegistration: { update(): Promise<unknown> } | undefined;
  const updateScheduler = createPwaUpdateCheckScheduler({
    getRegistration: () => swRegistration,
    subscribe: (target, type, listener) => {
      const node = target === 'document' ? document : window;
      node.addEventListener(type, listener);
      return () => node.removeEventListener(type, listener);
    },
  });
  // Abas atualizadas por outra aba: recarrega pelo mesmo gate de durabilidade.
  // O flag mutável suprime só o primeiro clientsClaim (instalação); claims
  // externos posteriores recarregam normalmente.
  let hadController = Boolean(navigator.serviceWorker?.controller);
  navigator.serviceWorker?.addEventListener('controllerchange', () => {
    if (!hadController) {
      hadController = true;
      return;
    }
    void controller.requestReload();
  });
  updateServiceWorker = registerSW({
    immediate: true,
    onRegisteredSW(_swUrl, registration) {
      swRegistration = registration ?? undefined;
      updateScheduler.start();
      void updateScheduler.check();
    },
    onNeedRefresh() {
      void controller.requestActivation();
    },
    onNeedReload() {
      void controller.requestReload();
    },
    onRegisterError(error) {
      controller.reportRegistrationError(error);
    },
  });
  window.addEventListener('concursos:pwa-retry', () => void controller.retry());

  if ('caches' in window) void cleanupInactiveContestCaches().catch(() => undefined);
  if (typeof navigator !== 'undefined' && navigator.storage?.persist) {
    void navigator.storage.persist().catch(() => undefined);
  }

  navigator.serviceWorker?.addEventListener('message', (event) => {
    if (event.data?.type === 'SYNC_REQUESTED') {
      const alias = getActiveAlias();
      if (alias) void requestCompleteProfileSync(alias);
    }
  });

  // Atualização periódica de pacotes para o app instalado (Periodic Background
  // Sync, apenas Chromium): o navegador decide quando disparar respeitando o
  // minInterval; a checagem real reusa o mesmo motor throttled da navegação.
  navigator.serviceWorker?.getRegistration().then((registration) => {
    const periodicSync = (
      registration as (ServiceWorkerRegistration & { periodicSync?: { register(tag: string, options: { minInterval: number }): Promise<void> } }) | undefined
    )?.periodicSync;
    if (!periodicSync) return;
    if (!window.matchMedia('(display-mode: standalone)').matches) return;
    void periodicSync
      .register('concursos-offline-updates', { minInterval: 24 * 60 * 60 * 1000 })
      .catch(() => undefined);
  }).catch(() => undefined);
</script>

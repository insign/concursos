<dialog
  class="question-resolution-dialog"
  data-resolution-dialog
  aria-labelledby="question-resolution-title"
>
  <div class="question-resolution-panel">
    <header class="question-resolution-header">
      <h2 id="question-resolution-title" data-resolution-title>Resolução passo a passo</h2>
      <button class="button button-secondary" type="button" data-resolution-close>
        Fechar
      </button>
    </header>
    <p class="question-resolution-status" data-resolution-status role="status" aria-live="polite" hidden></p>
    <div class="question-resolution-content" data-resolution-content></div>
  </div>
</dialog>

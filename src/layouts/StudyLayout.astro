---
import SubjectNavigation from '../components/SubjectNavigation.astro';
import SubjectPagination from '../components/SubjectPagination.astro';
import SubjectActionBar from '../components/SubjectActionBar.astro';
import NextSubjectSuggestion from '../components/NextSubjectSuggestion.astro';
import ReadingFocusRuntime from '../components/ReadingFocusRuntime.astro';
import BaseLayout from './BaseLayout.astro';
import type { CatalogContest, CatalogSubject } from '../lib/catalog';
import { studiedSubjectId } from '../lib/studied';

interface Props {
  contest: CatalogContest;
  subject: CatalogSubject;
  active: 'content' | 'cheat-sheet' | 'questions';
}

const { contest, subject, active } = Astro.props;
const groupId = subject.groupPath.at(-1)?.slug ?? null;
const subjectHref = `/concursos/${contest.slug}/${subject.slug}/`;
const currentSubjectId = studiedSubjectId(contest.storageId, subject.storageId);
const contestMiddleTruncated = contest.title.length > 32;
const contestLastWord = contest.title.split(/\s+/).at(-1) ?? '';
const contestTitleEnd = contestMiddleTruncated ? contestLastWord.slice(-16) : '';
const contestTitleStart = contestMiddleTruncated
  ? contest.title.slice(0, Math.max(8, 31 - contestTitleEnd.length))
  : contest.title;
---

<BaseLayout title={subject.title} description={subject.description} pageClass={`study-page ${active}`}>
  <main
    class="study-shell"
    data-navigation-root
    data-navigation-contest={contest.storageId}
    data-navigation-group={groupId ?? undefined}
    data-navigation-subject={subject.storageId}
    data-navigation-tab={active}
    data-navigation-mode="normal"
    data-navigation-content-version={subject.contentEntry.id}
  >
    <nav id="study-top" class="breadcrumbs print-hidden" aria-label="Caminho da página" tabindex="-1">
      <a class="breadcrumb-home" href="/" aria-label="Concursos" title="Concursos">
        <span aria-hidden="true">C</span>
      </a>
      <span aria-hidden="true">/</span>
      <a
        class:list={['breadcrumb-contest', { 'breadcrumb-contest-middle': contestMiddleTruncated }]}
        href={`/concursos/${contest.slug}/`}
        aria-label={contest.title}
        title={contest.title}
      >
        <span class="breadcrumb-contest-start" aria-hidden="true">{contestTitleStart}</span>
        {contestMiddleTruncated && <span class="breadcrumb-contest-ellipsis" aria-hidden="true">…</span>}
        {contestMiddleTruncated && <span class="breadcrumb-contest-end" aria-hidden="true">{contestTitleEnd}</span>}
      </a>
      {
        subject.groupPath.map((group) => (
          <>
            <span aria-hidden="true">/</span>
            <span class="breadcrumb-group" title={group.title}>{group.title}</span>
          </>
        ))
      }
    </nav>

    <header class="subject-heading">
      <p class="subject-title">{subject.title}</p>
      <p>{subject.description}</p>
    </header>

    <NextSubjectSuggestion
      contest={contest}
      instanceId="study-top"
      currentSubjectId={currentSubjectId}
    />

    <SubjectNavigation contestSlug={contest.slug} subjectSlug={subject.slug} active={active} />

    {
      active === 'content' ? (
        <div
          id="focus"
          class="reading-focus"
          data-reading-focus
          tabindex="-1"
          aria-label="Modo de leitura sem distrações"
        >
          <div class="reading-surface" data-navigation-content>
            <slot />
          </div>

          <SubjectActionBar
            contestSlug={contest.slug}
            contestStorageId={contest.storageId}
            subjectStorageId={subject.storageId}
            subjectHref={subjectHref}
            active={active}
          />
        </div>
      ) : (
        <div class="reading-surface" data-navigation-content>
          <slot />
        </div>
      )
    }

    <NextSubjectSuggestion
      contest={contest}
      instanceId="study-bottom"
      currentSubjectId={currentSubjectId}
    />

    <SubjectPagination contest={contest} subject={subject} />

    {
      active !== 'content' && (
        <SubjectActionBar
          contestSlug={contest.slug}
          contestStorageId={contest.storageId}
          subjectStorageId={subject.storageId}
          subjectHref={subjectHref}
          active={active}
        />
      )
    }
  </main>
  {active === 'content' && <ReadingFocusRuntime />}
</BaseLayout>

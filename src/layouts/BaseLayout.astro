---
import Header from '../components/Header.astro';
import NavigationRuntime from '../components/NavigationRuntime.astro';
import PwaRuntime from '../components/PwaRuntime.astro';
import SimuladosSyncRuntime from '../components/SimuladosSyncRuntime.astro';
import GlobalMediaPlayer from '../components/GlobalMediaPlayer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/print.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  hideHeader?: boolean;
}

const {
  title,
  description = 'Portal Git-first para estudo de concursos públicos.',
  pageClass = '',
  hideHeader = false,
} = Astro.props;
const pageTitle = title === 'Concursos' ? title : `${title} | Concursos`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#275d55" />
    {/* Anti-flash: resolve e aplica o tema (data-theme + theme-color) antes do paint,
        depois da meta theme-color para poder atualizá-la. Espelha a lógica de
        src/lib/theme.ts (DEFAULT_THEME_PREFERENCE/resolveTheme/THEME_COLORS); mantenha
        as duas em sincronia. Astro não hasheia is:inline, então o hash é fixado em
        astro.config.mjs e verificado no build por scripts/finalize-security.mjs. */}
    <script is:inline>(function(){try{var d=document.documentElement,k=localStorage.getItem('concursos:theme');if(k!=='light'&&k!=='dark'&&k!=='auto')k='auto';var t=(k==='dark'||(k!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches))?'dark':'light';d.dataset.theme=t;var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#101614':'#275d55');}catch(e){}})();</script>
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    {/* Precisa ser registrado antes do ClientRouter: ver src/lib/focus-history.ts. */}
    <script>
      import { installFocusHistoryGuard } from '../lib/focus-history';
      installFocusHistoryGuard();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class={pageClass || undefined}>
    <div id="app-shell">
      {!hideHeader && <Header />}
      <slot />
      <GlobalMediaPlayer />
      <p id="navigation-status" role="status" hidden></p>
    </div>
    {/* Na rota de simulados, o runtime recupera o histórico remoto completo; nas demais rotas,
        ele só acorda quando há uma outbox de simulados pendente. A ordem preserva a recuperação
        detalhada antes da sincronização periódica e mais leve da navegação. */}
    <SimuladosSyncRuntime />
    <NavigationRuntime />
    <PwaRuntime />
  </body>
</html>

<script>
  import { applyStoredTheme } from '../lib/theme';
  document.addEventListener('astro:after-swap', applyStoredTheme);
  window.addEventListener('concursos:navigation-error', (event) => {
    const status = document.getElementById('navigation-status');
    if (!status) return;
    status.hidden = false;
    status.textContent = (event as CustomEvent<Error>).detail?.message ?? 'Não foi possível abrir a página. Tente novamente.';
  });
</script>
